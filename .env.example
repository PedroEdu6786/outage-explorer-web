# Server-only Flask target. Leave blank to keep production operations unavailable.
# User-confirmed local target: http://localhost:8000
OUTAGE_API_ORIGIN=
# Run Next on its usual http://localhost:3000 unless backend configuration uses
# another browser-facing origin. Flask/Cognito must use that same public origin
# and callback: http://localhost:3000/api/auth/callback. Credentials stay in Flask.
