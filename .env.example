# Server-only Flask target. Leave blank to keep production operations unavailable.
# User-confirmed local target: http://localhost:8000
OUTAGE_API_ORIGIN=
COGNITO_DOMAIN=
COGNITO_APP_CLIENT_ID=
# Explicit URL already registered in Cognito Allowed sign-out URLs.
OUTAGE_AUTH_LOGOUT_URI=http://localhost:3000/sign-in
# Copy only the public domain/client ID from backend configuration. Never copy
# the backend's app client secret. Only the constructed logout URL reaches clients.
# Run Next on its usual http://localhost:3000 unless backend configuration uses
# another browser-facing origin. Flask OUTAGE_AUTH_UI_ORIGIN must match the UI;
# the existing Cognito callback remains http://localhost:8000/api/auth/callback.
# Credentials stay in Flask.
