{
  "name": "outage-explorer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture:evidence": "playwright test --config playwright.capture.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:production-fixtures": "node scripts/check-production-fixtures.mjs",
    "check:release-boundaries": "node scripts/check-boundaries.mjs --require-live && node scripts/check-production-fixtures.mjs --require-live",
    "test:boundaries": "node --test scripts/boundary-checks.test.mjs",
    "test:devlog": "python3 -m unittest discover -s tests/tooling -p 'test_devlog_hook.py' -v"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "postcss": "8.5.28",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
